        // --- 7. REAL-TIME SYNTAX HIGHLIGHTING ---
        function highlightSyntax(text, lang) {
            let escaped = text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");

            if (lang === 'html') {
                escaped = escaped.replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="tok-comm">$1</span>');
                escaped = escaped.replace(/(&lt;\/?)([a-zA-Z0-9-]+)([\s\S]*?)(\/?&gt;)/g, (m, open, tag, attrs, close) => {
                    const coloredAttrs = attrs.replace(/([a-zA-Z-]+)(=)("[^"]*"|'[^']*')/g, '<span class="tok-attr">$1</span>$2<span class="tok-str">$3</span>');
                    return `${open}<span class="tok-tag">${tag}</span>${coloredAttrs}${close}`;
                });
            } else if (lang === 'css') {
                escaped = escaped.replace(/(\/\*[\s\S]*?\*\/)/g, '<span class="tok-comm">$1</span>');
                escaped = escaped.replace(/([a-zA-Z-]+)(\s*:)/g, '<span class="tok-prop">$1</span>$2');
                escaped = escaped.replace(/(\b\d+(?:px|em|rem|%|vh|vw|s)?\b|#[0-9a-fA-F]{3,6})/g, '<span class="tok-num">$1</span>');
            } else if (lang === 'js') {
                escaped = escaped.replace(/(\/\/.*)/g, '<span class="tok-comm">$1</span>');
                escaped = escaped.replace(/("[^"]*"|'[^']*'|`[^`]*`)/g, '<span class="tok-str">$1</span>');
                escaped = escaped.replace(/\b(function|let|const|var|if|else|for|while|return|try|catch|new|true|false)\b/g, '<span class="tok-kw">$1</span>');
                escaped = escaped.replace(/\b(\d+)\b/g, '<span class="tok-num">$1</span>');
            } else if (lang === 'logic') {
                escaped = escaped.replace(/(#.*)/g, '<span class="tok-comm">$1</span>');
                escaped = escaped.replace(/("[^"]*"|'[^']*')/g, '<span class="tok-str">$1</span>');
                escaped = escaped.replace(/\b(if|elif|else|for|in|while|and|or|not|True|False)\b/g, '<span class="tok-kw">$1</span>');
                escaped = escaped.replace(/\b(print|range|len|int|str)\b/g, '<span class="tok-fn">$1</span>');
                escaped = escaped.replace(/\b(\d+)\b/g, '<span class="tok-num">$1</span>');
            }

            if (escaped.endsWith('\n')) escaped += ' ';
            return escaped;
        }

