        function startChallenge(id) {
            const c = challenges.find(x => x.id === id);
            if (!c) return;
            state.activeChallengeId = id;
            document.getElementById('challengeTitleDisplay').innerText = c.title;
            document.getElementById('challengeTaskDisplay').innerText = c.task;
            document.getElementById('activeChallengeBanner').classList.remove('hidden');

            if (c.mode === 'web') {
                state.code.html = c.starter.html || '';
                state.code.css = c.starter.css || '';
                state.code.js = c.starter.js || '';
                switchWebTab('html');
                switchMode('web');
            } else {
                state.code.logic = c.starter.logic || '';
                switchMode('logic');
            }
            closeModal('challengesModal');
            showToast("🎯 চ্যালেঞ্জ শুরু হয়েছে! কাজ শেষে 'যাচাই করুন' চাপুন");
        }

        function verifyActiveChallenge() {
            const c = challenges.find(x => x.id === state.activeChallengeId);
            if (!c) return;
            runCode(false);
            if (c.validate()) {
                if (!state.completedChallenges.includes(c.id)) {
                    state.completedChallenges.push(c.id);
                    state.xp += c.xp;
                    updateLevelBadge();
                    saveToStorage();
                }
                renderChallenges();
                showToast(`🎉 অভিনন্দন! আপনি +${c.xp} XP অর্জন করেছেন!`);
                exitChallenge();
            } else {
                showToast("❌ এখনো শর্ত পূরণ হয়নি! নির্দেশনা দেখে আবার চেষ্টা করুন।");
            }
        }

        function exitChallenge() {
            state.activeChallengeId = null;
            document.getElementById('activeChallengeBanner').classList.add('hidden');
        }

        function updateLevelBadge() {
            const lvl = Math.floor(state.xp / 100) + 1;
            document.getElementById('levelBadge').innerText = `লেভেল ${lvl} • ${state.xp} XP`;
        }

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        let toastTimer;
        function showToast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            t.classList.remove('opacity-0');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => t.classList.add('opacity-0'), 2800);
        }
    </script>
</body>
</html>
