                const pyRange = (start, end, step = 1) => {
                    if (end === undefined) { end = start; start = 0; }
                    const res = [];
                    if (step > 0) { for (let i = start; i < end; i += step) res.push(i); }
                    else if (step < 0) { for (let i = start; i > end; i += step) res.push(i); }
                    return res;
                };

                const fn = new Function('print', 'range', jsCode);
                fn(pyPrint, pyRange);

                if (state.consoleLogs.length === 0) {
