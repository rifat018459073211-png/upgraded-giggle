        /* ==================== LARGE COMFORTABLE SYNTAX HIGHLIGHTED EDITOR ==================== */
        .editor-wrapper {
            position: relative;
            flex: 1;
            min-height: 380px;
            background: #141927;
            overflow: hidden;
        }

        .code-font-metrics {
            font-family: 'JetBrains Mono', monospace;
