            const end = codeEditor.selectionEnd;
            const selected = codeEditor.value.substring(start, end);
            const full = openStr + selected + closeStr;
            codeEditor.value = codeEditor.value.substring(0, start) + full + codeEditor.value.substring(end);
            const targetPos = start + openStr.length + selected.length;
            codeEditor.focus();
            codeEditor.setSelectionRange(targetPos, targetPos);
            commitCodeChange();
        }

        function insertSmartNewline() {
            pushUndo();
            const start = codeEditor.selectionStart;
            const before = codeEditor.value.substring(0, start);
            const lastLine = before.split('\n').pop();
            const match = lastLine.match(/^(\s*)/);
            let indent = match ? match[1] : '';
            if (lastLine.trim().endsWith('{') || lastLine.trim().endsWith(':')) indent += '    ';

            const ins = '\n' + indent;
            codeEditor.value = before + ins + codeEditor.value.substring(codeEditor.selectionEnd);
            const pos = start + ins.length;
            codeEditor.focus();
            codeEditor.setSelectionRange(pos, pos);
            commitCodeChange();
        }

        function moveCursor(delta) {
            const pos = Math.max(0, Math.min(codeEditor.value.length, codeEditor.selectionStart + delta));
            codeEditor.focus();
            codeEditor.setSelectionRange(pos, pos);
            updateCursorStats();
        }

