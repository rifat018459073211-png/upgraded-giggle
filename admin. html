        function transpilePythonToJS(src) {
            const lines = src.split('\n');
            let out = [];
            let indentStack = [0];
            const vars = new Set();

            out.push(`function __mul(a, b) { if (typeof a === 'string' && typeof b === 'number') return a.repeat(Math.max(0, b)); if (typeof b === 'string' && typeof a === 'number') return b.repeat(Math.max(0, a)); return a * b; }`);

            for (let i = 0; i < lines.length; i++) {
                let line = stripComments(lines[i]);
                if (!line.trim()) continue;
                const indent = line.match(/^(\s*)/)[1].length;
                let trimmed = line.trim();

                while (indent < indentStack[indentStack.length - 1]) {
                    indentStack.pop();
                    out.push('}');
                }

                trimmed = trimmed.replace(/("[^"]*"|'[^']*')\s*\*\s*([a-zA-Z0-9_\u0980-\u09FF]+)/g, '__mul($1, $2)');

                if (trimmed.startsWith('if ') && trimmed.endsWith(':')) {
                    const cond = trimmed.slice(3, -1).replace(/\band\b/g, '&&').replace(/\bor\b/g, '||').replace(/\bnot\b/g, '!');
                    out.push(`if (${cond}) {`);
                    indentStack.push(indent + 4);
                } else if (trimmed.startsWith('elif ') && trimmed.endsWith(':')) {
                    const cond = trimmed.slice(5, -1).replace(/\band\b/g, '&&').replace(/\bor\b/g, '||');
                    out.push(`else if (${cond}) {`);
                    indentStack.push(indent + 4);
                } else if (trimmed === 'else:') {
                    out.push(`else {`);
                    indentStack.push(indent + 4);
                } else if (trimmed.startsWith('for ') && trimmed.includes(' in ') && trimmed.endsWith(':')) {
                    const m = trimmed.match(/^for\s+([a-zA-Z0-9_\u0980-\u09FF]+)\s+in\s+(.+):$/);
                    if (m) {
                        out.push(`for (let ${m[1]} of ${m[2]}) {`);
                        indentStack.push(indent + 4);
                    } else {
                        throw new Error(`লাইন ${i + 1}: for লুপ লেখার নিয়ম ঠিক হয়নি।`);
                    }
                } else if (trimmed.startsWith('while ') && trimmed.endsWith(':')) {
                    const cond = trimmed.slice(6, -1);
                    out.push(`let __g_${i} = 0; while (${cond}) { if (++__g_${i} > 5000) throw new Error("অসীম লুপ থামানো হয়েছে!");`);
                    indentStack.push(indent + 4);
                } else {
                    const assign = trimmed.match(/^([a-zA-Z_\u0980-\u09FF][a-zA-Z0-9_\u0980-\u09FF]*)\s*=\s*(.+)$/);
                    if (assign && !trimmed.includes('==')) {
                        const name = assign[1], val = assign[2];
                        if (!vars.has(name)) {
                            vars.add(name);
                            out.push(`let ${name} = ${val};`);
                        } else {
                            out.push(`${name} = ${val};`);
                        }
                    } else {
                        out.push(trimmed + ';');
                    }
                }
            }

            while (indentStack.length > 1) {
                indentStack.pop();
                out.push('}');
            }
            return out.join('\n');
        }

        function stripComments(line) {
            let s = false, d = false;
            for (let i = 0; i < line.length; i++) {
                if (line[i] === "'" && !d) s = !s;
                else if (line[i] === '"' && !s) d = !d;
                else if (line[i] === '#' && !s && !d) return line.slice(0, i);
            }
            return line;
        }

        function checkBracketBalance(code) {
            for (const [o, c] of [['(', ')'], ['{', '}'], ['[', ']']]) {
                const oc = code.split(o).length - 1;
                const cc = code.split(c).length - 1;
                if (oc > cc) return `কোডে '${o}' চিহ্নটি খোলা হয়েছে কিন্তু '${c}' দিয়ে বন্ধ করা হয়নি!`;
                if (cc > oc) return `কোডে একটি অতিরিক্ত '${c}' চিহ্ন পড়ে গেছে!`;
            }
            return null;
        }

        function translateError(msg) {
            if (!msg) return "কোডে একটি সিনট্যাক্স ভুল হয়েছে।";
            const s = String(msg);
            if (s.includes("Unexpected end of input")) return "কোডের শেষে কোনো ব্র্যাকেট '}' বা ')' বন্ধ করতে ভুলে গেছেন!";
            if (s.includes("Unexpected token")) return "কোডের কোথাও ভুল চিহ্ন বসেছে বা কোটেশন (\" \") ঠিকমতো বন্ধ হয়নি।";
            if (s.includes("is not defined")) return `'${s.split(' ')[0]}' নামটি আগে তৈরি করা হয়নি অথবা লেখাটি কোটেশন (" ") এর ভেতরে দিতে ভুলে গেছেন!`;
            return s;
        }

